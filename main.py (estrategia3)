# ----------------- util/persistência -----------------

def load_config() -> Dict[str, Any]:
    with open("config/config.yaml", "r", encoding="utf-8") as f:
        return yaml.safe_load(f)

def save_trade_to_json(rec: Dict[str, Any]):
    try:
        if os.path.exists(PERSIST_JSON):
            with open(PERSIST_JSON, "r", encoding="utf-8") as f:
                data = json.load(f)
        else:
            data = {}
        key = f"{rec.get('symbol','UNK')}-{datetime.utcnow().isoformat()}"
        data[key] = rec
        with open(PERSIST_JSON, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2, ensure_ascii=False)
    except Exception as e:
        print("Erro salvando JSON:", e)

def append_trade_csv(rec: Dict[str, Any]):
    try:
        os.makedirs("data", exist_ok=True)
        header = not os.path.exists(TRADES_CSV)
        with open(TRADES_CSV, "a", encoding="utf-8") as f:
            if header:
                f.write("ts,symbol,side,qty,entry,stop,tp,order_id,status\n")
            f.write("{ts},{symbol},{side},{qty},{entry},{stop},{tp},{order_id},{status}\n".format(
                ts=datetime.utcnow().isoformat(),
                symbol=rec.get("symbol",""),
                side=rec.get("side",""),
                qty=rec.get("qty",""),
                entry=rec.get("entry",""),
                stop=rec.get("stop",""),
                tp=rec.get("tp",""),
                order_id=rec.get("order_id",""),
                status=rec.get("status",""),
            ))
    except Exception as e:
        print("Erro salvando CSV:", e)

def save_runtime_state():
    try:
        from datetime import date as _date, datetime as _dt
        with open(RUNTIME_JSON, "w", encoding="utf-8") as f:
            day_val = _state.get("day")
            if isinstance(day_val, (_date, _dt)):
                day_val = day_val.isoformat()
            json_state = {
                **_state,
                "day": day_val,
                "open_symbols": sorted(list(_state.get("open_symbols", set()))),
                "open_positions_info": _state.get("open_positions_info", {}),
            }
            json.dump(json_state, f, indent=2, ensure_ascii=False)
    except Exception:
        pass

def load_runtime_state_from_disk():
    if not os.path.exists(RUNTIME_JSON):
        return
    try:
        with open(RUNTIME_JSON, "r", encoding="utf-8") as f:
            data = json.load(f)
        stored_daily = data.get("daily") or {}
        default_daily = {"trades": 0,"wins": 0,"losses": 0,"consecutive_losses": 0,"realized_pnl": 0.0}
        default_daily.update(stored_daily)
        from datetime import date as _date
        day_raw = data.get("day")
        try:
            day_norm = _date.fromisoformat(day_raw) if isinstance(day_raw, str) else None
        except Exception:
            day_norm = None
        _state.update({
            "day": day_norm,
            "equity_start": data.get("equity_start"),
            "circuit_paused": bool(data.get("circuit_paused", False)),
            "last_equity": float(data.get("last_equity", 0.0) or 0.0),
            "daily": default_daily,
        })
        _state["open_symbols"] = set(data.get("open_symbols", []) or [])
        stored_positions = data.get("open_positions_info", {}) or {}
        normalized_positions = {}
        for sym, info in stored_positions.items():
            qty = info.get("qty"); entry = info.get("entry"); stop = info.get("stop")
            normalized_positions[sym] = {
                "qty": float(qty) if qty is not None else None,
                "entry": float(entry) if entry is not None else None,
                "side": (info.get("side") or "").lower(),
                "stop": float(stop) if stop else None,
                "tp_targets": [float(t) for t in info.get("tp_targets", []) if t],
                "be_done": bool(info.get("be_done", False)),
                "hw": info.get("hw"),
                "lw": info.get("lw"),
            }
        _state["open_positions_info"] = normalized_positions
    except Exception:
        _state["open_symbols"] = set()
        _state["open_positions_info"] = {}

def rehydrate_runtime_state(exchange: Exchange, logger: Logger):
    try:
        positions = exchange.fetch_positions_map()
    except Exception as exc:
        logger.warning(f"Falha ao reidratar posições: {exc}")
        return
    live_symbols = set()
    for sym, info in positions.items():
        size = abs(float(info.get("size") or 0.0))
        if size <= 0: continue
        side = str(info.get("side") or ("long" if info.get("size", 0) > 0 else "short")).lower()
        entry = float(info.get("entryPrice") or 0.0)
        live_symbols.add(sym)
        stored = _state["open_positions_info"].get(sym, {})
        _state["open_positions_info"][sym] = {
            "qty": float(stored.get("qty", size) or size),
            "entry": float(stored.get("entry", entry) or entry),
            "side": (stored.get("side") or side or "").lower(),
            "stop": float(stored.get("stop")) if stored.get("stop") else None,
            "tp_targets": [float(t) for t in (stored.get("tp_targets") or []) if t],
            "be_done": bool(stored.get("be_done", False)),
            "hw": stored.get("hw"),
            "lw": stored.get("lw"),
        }
    for sym in list(_state.get("open_positions_info", {}).keys()):
        if sym not in live_symbols:
            _state["open_positions_info"].pop(sym, None)
    _state["open_symbols"] = live_symbols
    save_runtime_state()

def validate_config(cfg: Dict[str, Any], logger: Logger):
    trade = cfg.get("trade", {})
    risk_pct = float(trade.get("risk_per_trade", 1.0) or 0.0)
    if risk_pct <= 0:
        logger.warning("risk_per_trade <= 0 detectado. Ajustando para 1%.")
        trade["risk_per_trade"] = 1.0
    elif risk_pct > 2.0:
        # manter estilo que funcionou no seu logger (sem placeholders adicionais)
        logger.warning(f"risk_per_trade={risk_pct}% é alto para produção. (Sugerido <=2%.) Mantendo valor a pedido do usuário.")
    max_notional = float(trade.get("max_notional_pct", 0.10) or 0.0)
    if max_notional <= 0 or max_notional > 1:
        logger.warning("max_notional_pct inválido. Normalizando para 0.10 (10%).")
        trade["max_notional_pct"] = 0.10
    cfg["trade"] = trade


# ----------------- proteções/limites -----------------

def _reset_day(equity_now: float):
    _state["day"] = date.today()
    _state["equity_start"] = equity_now
    _state["circuit_paused"] = False
    _state["daily"] = {"trades":0,"wins":0,"losses":0,"consecutive_losses":0,"realized_pnl":0.0}

def in_no_trade_window(cfg_trade: dict) -> bool:
    windows = cfg_trade.get("no_trade_hours", [])
    if not windows: return False
    now = datetime.now(timezone.utc).time()
    for w in windows:
        try:
            a, b = w.split("-"); h1, m1 = map(int, a.split(":")); h2, m2 = map(int, b.split(":"))
            if dtime(h1, m1) <= now <= dtime(h2, m2): return True
        except Exception:
            continue
    return False

def _check_circuit_breaker(equity_now: float, limit_pct: float) -> bool:
    if _state["day"] != date.today() or _state["equity_start"] is None:
        _reset_day(equity_now); return False
    if _state["equity_start"] <= 0: return False
    dd = (equity_now - _state["equity_start"]) / _state["equity_start"] * 100.0
    _state["last_equity"] = equity_now
    if dd <= -abs(limit_pct): _state["circuit_paused"] = True
    return _state["circuit_paused"]


